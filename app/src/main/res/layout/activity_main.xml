<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vertical_transparente"
    tools:context=".view.MainActivity">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#68000000"
        android:backgroundTint="#0E0E0E"
        android:text="@string/boasVinda"
        android:textColor="@color/material_dynamic_neutral95"
        android:textSize="50px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.308" />

    <!-- Botão Calcular -->

    <!-- Botão Selecionar Usuário -->
    <Button
        android:id="@+id/bCalcular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="8dp"
        android:enabled="false"
        android:text="Realizar\nCálculo"
        app:layout_constraintEnd_toStartOf="@+id/btnAbrirUsuarios"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <Button
        android:id="@+id/btnAbrirUsuarios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginStart="8dp"
        android:text="Selecionar\nUsuário"
        app:layout_constraintBottom_toBottomOf="@+id/bCalcular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bCalcular"
        app:layout_constraintTop_toTopOf="@+id/bCalcular" />

</androidx.constraintlayout.widget.ConstraintLayout>